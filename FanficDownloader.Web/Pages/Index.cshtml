    <script>
        let debounceTimer;
        let lastRequestId = 0;
        let activeJobId = null;
        var urlInput = document.getElementById("urlInput");
            urlInput.addEventListener("input", () => {
            clearTimeout(debounceTimer);

            debounceTimer = setTimeout(() => {
                    loadPreview();
                }, 500); // 500ms задержка
            });

        function hideDownloadProgress() {
            var loader = document.getElementById("downloadLoading");
            var queueText = document.getElementById("queueText");
            var progressSection = document.getElementById("downloadProgressSection");
            var progressBar = document.getElementById("progressBar");
            var progressPercent = document.getElementById("progressPercent");
            var estimateText = document.getElementById("estimateText");

            if (loader) loader.classList.add("hidden");
            if (queueText) queueText.innerText = "";
            if (progressSection) progressSection.classList.add("hidden");
            if (progressBar) progressBar.style.width = "0%";
            if (progressPercent) progressPercent.innerText = "0%";
            if (estimateText) estimateText.innerText = "";
        }

        async function loadPreview() {
            try {
                    
                    const requestId = ++lastRequestId;
                    var url = urlInput.value.trim();
                    if (!url) {
                        hideDownloadProgress();
                        return;
                    }

                    hideDownloadProgress();

                    
                    document.getElementById("btnEpub").disabled = true;
                    document.getElementById("btnTxt").disabled = true;

                    var response = await fetch("/download/info", {
                    method: "POST",
                    body: new URLSearchParams({ Url: url })
                    });
                    if (!response.ok) return;
                    var fic = await response.json();
                    if (requestId !== lastRequestId) return;
                    document.getElementById("btnEpub").disabled = false;
                    document.getElementById("btnTxt").disabled = false;

                    document.getElementById("estimateText").innerText =
                    `${fic.chapters?.length * 4 ?? 0} sec estimated`;
                    console.log("fic", fic);

                    if (!fic || !fic.title) return;
                    var card = document.getElementById("fanficCard");
                    card.classList.remove("hidden");

                    document.getElementById("ficTitle").innerText = fic.title;
                    document.getElementById("ficAuthor").innerText =
                                            fic.authors?.join(", ") ?? "Unknown author";

                    document.getElementById("ficDescription").innerText =
                                            fic.description ?? "NO DESCRIPTION";

                                                                            
                    document.getElementById("ficFandoms").innerText = fic.fandoms?.join(", ") ?? "";
                    document.getElementById("ficPairings").innerText = fic.pairings?.join(", ") ?? "";
                    document.getElementById("ficChapters").innerText = fic.chapters?.length ?? "0";
                    const notesEl = document.getElementById("ficNotes");
                    const container = notesEl.closest("div");

                    const notes = fic.notes ?? "";

                    if (notes.trim()) {
                        notesEl.innerText = notes;
                    } else {
                        container.classList.add("hidden"); // Tailwind
                    }

                    var tagsRow = document.getElementById("rowTags");
                    tagsRow.innerHTML = "";

                    if (fic.tags && fic.tags.length > 0) {

                        var max = 8;
                        var visibleTags = fic.tags.slice(0, max);

                        for (var tag of visibleTags) {
                            var el = document.createElement("span");

                            el.className = "px-3 py-1.5 bg-surface-container-lowest rounded-lg text-xs font-bold text-on-surface-variant border border-outline-variant/10 shadow-sm";

                            el.innerText = tag;

                            tagsRow.appendChild(el);
                        }

                        if (fic.tags.length > max) {
                            var more = document.createElement("span");
                            more.className = "px-3 py-1.5 rounded-lg text-xs font-bold text-primary bg-primary/10";

                            more.innerText = `+${fic.tags.length - max}`;

                            tagsRow.appendChild(more);
                                                                            
                        }

                    } else {
                        tagsRow.innerHTML = "<span class='text-sm text-gray-400'>No tags</span>";
                    }

                } catch (e) {
                    console.error("ERROR:", e);
                }
            }


        async function triggerDownload(format) {
            var url = urlInput.value.trim();
            if (!url) return;

            var btnEpub = document.getElementById("btnEpub");
            var btnTxt = document.getElementById("btnTxt");
            var loader = document.getElementById("downloadLoading");
            var queueText = document.getElementById("queueText");
            var progressSection = document.getElementById("downloadProgressSection");
            var progressBar = document.getElementById("progressBar");
            var progressPercent = document.getElementById("progressPercent");
            btnEpub.disabled = true;
            btnTxt.disabled = true;
            loader.classList.remove("hidden");
            progressSection.classList.remove("hidden");
            activeJobId = null;

            if (progressBar) progressBar.style.width = "0%";
            if (progressPercent) progressPercent.innerText = "0%";

            try {
                var response = await fetch(`/download/start/${format}`, {
                    method: "POST",
                    body: new URLSearchParams({ Url: url })
                });

                if (!response.ok) {
                    console.error("Download failed");
                    return;
                }

                const startResult = await response.json();
                const jobId = startResult.jobId;

                if (!jobId) {
                    console.error("No JobId returned");
                    return;
                }
                activeJobId = jobId;

                const initialPosition = startResult.queuePosition || 1;
                queueText.innerText = initialPosition === 1
                    ? "You're next! Preparing your file..."
                    : `You're #${initialPosition} in queue. Preparing your file...`;

                await waitForCompletion(jobId, progressBar, progressPercent, queueText);

                queueText.innerText = "File is ready. Starting download...";

                var fileResponse = await fetch(`/download/file/${jobId}`);

                if (!fileResponse.ok) {
                    throw new Error("File download failed");
                }

                var blob = await fileResponse.blob();
                var disposition = fileResponse.headers.get("content-disposition");
                var fileName = "fanfic";

                if (disposition) {
                    var parts = disposition.split(";");
                    for (var p of parts) {
                        p = p.trim();
                        if (p.startsWith("filename*="))
                            fileName = decodeURIComponent(p.split("''")[1]);
                        else if (p.startsWith("filename="))
                            fileName = p.replace("filename=", "").replace(/"/g, "");
                    }
                }

                var link = document.createElement("a");
                var objectUrl = window.URL.createObjectURL(blob);

                link.href = objectUrl;
                link.download = fileName;
                link.click();

                window.URL.revokeObjectURL(objectUrl);
                urlInput.value = "";
                setTimeout(() => {
                        const card = document.getElementById("fanficCard");
                        if (card) {
                            card.classList.add("hidden");
                        }
                    }, 1000);
            }
            catch (e) {
                console.error("download error", e);
                queueText.innerText = "Download failed. Please try again.";
            }
            finally {
                loader.classList.add("hidden");
                btnEpub.disabled = false;
                btnTxt.disabled = false;
                activeJobId = null;
            }
        }

        async function waitForCompletion(jobId, progressBar, progressPercent, queueText) {
            while (activeJobId === jobId) {
                const res = await fetch(`/download/progress/${jobId}`, {
                    cache: "no-store"
                });

                if (!res.ok) {
                    throw new Error("Progress polling failed");
                }
                

                const progress = await res.json();
                const percent = progress.percent || 0;
                const total = progress.totalChapters || 0;
                const done = progress.completedChapters || 0;
                const status = progress.status || "queued";

                if (progressBar) progressBar.style.width = percent + "%";
                if (progressPercent) progressPercent.innerText = percent + "%";

                if (status === "queued") {
                    const queuePosition = progress.queuePosition || 1;
                    queueText.innerText = queuePosition === 1
                        ? "You're next! Preparing your file..."
                        : `You're #${queuePosition} in queue. Preparing your file...`;
                }

                if (status === "running") {
                    queueText.innerText = total > 0
                        ? `Downloading chapters: ${done}/${total}`
                        : "Preparing chapters...";
                }

                if (status === "failed") {
                    throw new Error(progress.error || "Download failed");
                }

                if (status === "completed") {
                    if (progressBar) progressBar.style.width = "100%";
                    if (progressPercent) progressPercent.innerText = "100%";
                    return;
                }

                await new Promise(resolve => setTimeout(resolve, 500));
            }
        }

    </script>
    <script>
        lucide.createIcons();
    </script>
